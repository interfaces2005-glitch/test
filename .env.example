PORT=3001
DATABASE_URL=postgresql://lumi:lumi_local@localhost:5432/lumi
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3001
ADMIN_PASSWORD=replace-with-a-long-unique-password
STUDIO_TIMEZONE=Asia/Bishkek
STUDIO_ADDRESS=Бишкек, ул. Исанова, 172 (ориентировочно)
NODE_ENV=development
# Set VITE_DEMO=false before building the frontend for the real API.
VITE_DEMO=false
# Stable random secret for private appointment links (otherwise ADMIN_PASSWORD is used).
BOOKING_LINK_SECRET=
# WhatsApp option 1: HTTPS adapter for your Business provider.
# JSON contains {id,to,kind,audience,template,language,text,parameters,manageUrl}.
# The adapter must honor Idempotency-Key and use approved WhatsApp templates.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
# WhatsApp option 2: Meta Cloud API, if no webhook is set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set a supported Graph API version for your account, e.g. vNN.0.
WHATSAPP_API_VERSION=
WHATSAPP_LANGUAGE=ru
# Approved template names. Each has 9 text body parameters; see README.
WA_CLIENT_PENDING_TEMPLATE=
WA_CLIENT_CONFIRMED_TEMPLATE=
WA_CLIENT_REMINDER_TEMPLATE=
WA_CLIENT_CANCELLED_TEMPLATE=
WA_STAFF_NEW_TEMPLATE=
WA_STAFF_CONFIRMED_TEMPLATE=
WA_STAFF_RECEIPT_TEMPLATE=
WA_STAFF_CANCELLED_TEMPLATE=
